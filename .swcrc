{
  "$schema": "https://swc.rs/schema.json",
  "env": {
    "targets": "node 20"
  },
  "jsc": {
    "externalHelpers": true,
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "decoratorVersion": "2022-03",
      "react": {
        "runtime": "automatic"
      }
    },
    "baseUrl": "./",
    "paths": {
      "@/src/*": [
        "./src/*"
      ],
      "@/tools/*": [
        "./tools/*"
      ]
    }
  },
  "module": {
    "type": "es6"
  },
  "sourceMaps": true
}
