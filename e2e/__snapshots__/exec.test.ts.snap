// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`jill exec > using npm > should print task plan and do not run any script 1`] = `
"[1m       Job                                                                Depends on[22m
[1m[22m#1     Run [1mbuild[22m script in wks-c                                 
└─ #2  node -e "require('node:fs').writeFileSync('script.txt', 'build')"  
#3     node -e "require('node:fs').writeFileSync('script.txt', 'node')"   #1"
`;

exports[`jill exec > using yarn > should print task plan and do not run any script 1`] = `
"[1m       Job                                                                          Depends on[22m
[1m[22m#1     Run [1mbuild[22m script in wks-c                                           
└─ #2  yarn exec node -e "require('node:fs').writeFileSync('script.txt', 'build')"  
#3     yarn exec node -e "require('node:fs').writeFileSync('script.txt', 'node')"   #1"
`;
