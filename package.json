{
  "name": "@jujulego/jill",
  "version": "3.0.0-alpha.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jujulego/jill"
  },
  "files": [
    "./bin",
    "./dist"
  ],
  "type": "module",
  "bin": "./bin/jill.js",
  "exports": "./dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -rf dist",
    "build": "yarn run build:bundle && yarn run build:types",
    "build:bundle": "rollup -c",
    "build:types": "tsc -p tsconfig.build.json",
    "watch": "rollup -c --watch",
    "test": "vitest run tests tools",
    "e2e": "vitest run e2e --slow-test-threshold=5000",
    "e2e:npm": "yarn run e2e -t npm --slow-test-threshold=5000",
    "e2e:yarn": "yarn run e2e -t yarn --slow-test-threshold=5000"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "dependencies": {
    "@jujulego/quick-tag": "^1.0.3",
    "@jujulego/tasks": "3.0.0-alpha.6",
    "@kyrielle/injector": "^1.1.0",
    "@kyrielle/logger": "^2.0.0",
    "@sentry/node": "^10.5.0",
    "@swc/helpers": "^0.5.3",
    "ajv": "^8.12.0",
    "chalk": "^5.5.0",
    "chalk-template": "^1.1.0",
    "cosmiconfig": "^9.0.0",
    "glob": "^11.0.3",
    "ink": "^6.2.1",
    "ink-spinner": "^5.0.0",
    "is-unicode-supported": "^2.1.0",
    "kyrielle": "^2.5.3",
    "moo": "^0.5.2",
    "normalize-package-data": "^8.0.0",
    "path-scurry": "^2.0.0",
    "pretty-ms": "^9.2.0",
    "react": "^19.1.0",
    "semver": "^7.7.2",
    "slugify": "^1.6.6",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "1.9.1",
    "@eslint/js": "9.38.0",
    "@jujulego/2d-maths": "1.6.0",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@sentry/rollup-plugin": "4.5.0",
    "@swc/core": "1.13.20",
    "@types/moo": "0.5.10",
    "@types/node": "22.18.12",
    "@types/normalize-package-data": "2.4.4",
    "@types/react": "19.2.2",
    "@types/semver": "7.7.1",
