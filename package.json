    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.3.26",
    "@vitest/expect": "3.2.4",
    "eslint": "9.38.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "ink-testing-library": "4.0.0",
    "jiti": "2.6.1",
    "memfs": "4.49.0",
    "rollup": "4.52.5",
    "shx": "0.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
