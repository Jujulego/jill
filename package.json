{
  "name": "@jujulego/jill",
  "version": "3.0.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jujulego/jill"
  },
  "files": [
    "./bin",
    "./dist"
  ],
  "type": "module",
  "bin": "./bin/jill.js",
  "exports": "./dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -rf dist",
    "build": "yarn run build:bundle && yarn run build:types",
    "build:bundle": "rollup -c",
    "build:types": "tsc -p tsconfig.build.json",
    "watch": "rollup -c --watch",
    "test": "vitest run tests tools",
    "test:types": "tsc --project tsconfig.tests.json",
    "e2e": "vitest run e2e --slow-test-threshold=5000",
    "e2e:npm": "yarn run e2e -t npm --slow-test-threshold=5000",
    "e2e:yarn": "yarn run e2e -t yarn --slow-test-threshold=5000"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "dependencies": {
    "@sentry/node": "^10.0.0",
    "@swc/helpers": "^0.5.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "1.9.1",
    "@eslint/js": "9.39.4",
    "@jujulego/2d-maths": "1.6.0",
    "@jujulego/quick-tag": "1.1.0",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@kyrielle/injector": "1.1.0",
    "@kyrielle/logger": "2.0.0",
    "@kyrielle/workload": "1.0.0",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@sentry/rollup-plugin": "5.1.1",
    "@swc/core": "1.15.18",
    "@types/moo": "0.5.10",
    "@types/node": "24.12.0",
    "@types/normalize-package-data": "2.4.4",
    "@types/react": "19.2.14",
    "@types/semver": "7.7.1",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/utils": "8.57.1",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/eslint-plugin": "1.6.13",
    "@vitest/expect": "4.1.0",
    "ajv": "8.18.0",
    "chalk": "5.6.2",
    "chalk-template": "1.1.2",
    "cosmiconfig": "9.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "glob": "13.0.6",
    "globals": "17.4.0",
    "ink": "6.8.0",
    "ink-spinner": "5.0.0",
    "ink-testing-library": "4.0.0",
    "is-unicode-supported": "2.1.0",
    "jiti": "2.6.1",
    "kyrielle": "2.8.3",
    "memfs": "4.57.1",
    "moo": "0.5.3",
    "normalize-package-data": "8.0.0",
    "path-scurry": "2.0.2",
    "pretty-ms": "9.3.0",
    "react": "19.2.4",
    "rollup": "4.59.1",
    "semver": "7.7.4",
    "shx": "0.4.0",
    "slugify": "1.6.8",
    "ts-node": "10.9.2",
