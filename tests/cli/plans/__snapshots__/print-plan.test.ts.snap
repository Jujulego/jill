exports[`printPlan > should print simple plan 1`] = `
"[1m   Job[22m
[1m[22m#1  test
"
`;

exports[`printPlan > should print plan with dependencies 1`] = `
"[1m    Job  Depends on[22m
[1m[22m#1  dep  
#2  job  #1
"
`;

exports[`printPlan > should print plan with workflow members 1`] = `
"[1m       Job[22m
[1m[22m#1     test
├─ #2  A
└─ #3  B
"
`;
